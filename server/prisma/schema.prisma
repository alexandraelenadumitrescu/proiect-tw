generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conference_authors {
  id            Int         @id @default(autoincrement())
  conference_id Int
  author_id     Int
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  users         users       @relation(fields: [author_id], references: [id], onDelete: Cascade)
  conferences   conferences @relation(fields: [conference_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conference_reviewers {
  id              Int               @id @default(autoincrement())
  conference_id   Int
  reviewer_id     Int
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  conferences     conferences       @relation(fields: [conference_id], references: [id], onDelete: Cascade)
  users           users             @relation(fields: [reviewer_id], references: [id], onDelete: Cascade)
  paper_reviewers paper_reviewers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conferences {
  id                   Int                    @id @default(autoincrement())
  organizer_id         Int
  name                 String                 @db.VarChar
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  conference_authors   conference_authors[]
  conference_reviewers conference_reviewers[]
  users                users                  @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
  papers               papers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model paper_reviewers {
  id                           Int                  @id @default(autoincrement())
  paper_id                     Int
  conference_reviewer_entry_id Int
  created_at                   DateTime             @default(now()) @db.Timestamptz(6)
  conference_reviewers         conference_reviewers @relation(fields: [conference_reviewer_entry_id], references: [id], onDelete: Cascade)
  papers                       papers               @relation(fields: [paper_id], references: [id], onDelete: Cascade)
  reviews                      reviews[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model paper_versions {
  id             Int      @id @default(autoincrement())
  paper_id       Int
  version_number Int
  file_name      String   @db.VarChar
  file_contents  Bytes
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  papers         papers   @relation(fields: [paper_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model papers {
  id              Int               @id @default(autoincrement())
  author_id       Int
  conference_id   Int
  title           String            @db.VarChar
  status          String            @db.VarChar
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  paper_reviewers paper_reviewers[]
  paper_versions  paper_versions[]
  users           users             @relation(fields: [author_id], references: [id], onDelete: Cascade)
  conferences     conferences       @relation(fields: [conference_id], references: [id], onDelete: Cascade)
  reviews         reviews[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reviews {
  id                      Int              @id @default(autoincrement())
  paper_version_id        Int
  paper_reviewer_entry_id Int?
  decision                String           @db.VarChar
  comments                String?
  created_at              DateTime         @default(now()) @db.Timestamptz(6)
  paper_reviewers         paper_reviewers? @relation(fields: [paper_reviewer_entry_id], references: [id], onDelete: Cascade)
  papers                  papers           @relation(fields: [paper_version_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_roles {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_type  String   @db.VarChar
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                   Int                    @id @default(autoincrement())
  email                String                 @unique @db.VarChar
  password_hash        String                 @db.VarChar
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  conference_authors   conference_authors[]
  conference_reviewers conference_reviewers[]
  conferences          conferences[]
  papers               papers[]
  user_roles           user_roles[]
}
